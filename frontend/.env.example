# hiAnzy — frontend configuration
# Copy to .env and fill in. Never commit the real .env.

# Base URL of the backend. The API client appends /api itself, so set the
# origin only — e.g. http://localhost:8001 locally.
REACT_APP_BACKEND_URL=

# Dev-server websocket port. 0 lets CRA infer it (correct behind a proxy).
WDS_SOCKET_PORT=

# Disables the dev-server health check ping.
ENABLE_HEALTH_CHECK=

# Bind the dev server to loopback. CRA defaults to 0.0.0.0, which puts your
# work-in-progress on every network you join.
HOST

# Public origin, used to build absolute URLs in sitemap.xml and robots.txt.
# Set this to the real domain before a production build or the sitemap will
# advertise the placeholder.
SITE_URL

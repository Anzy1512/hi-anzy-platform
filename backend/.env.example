# Hi Anzy — backend configuration
# Copy to .env and fill in. Never commit the real .env.

# ── Database (required) ──────────────────────────────────────────────────────
MONGO_URL=
DB_NAME=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for local development.
CORS_ORIGINS=

# ── Session cookie ───────────────────────────────────────────────────────────
# Production: COOKIE_SECURE=true and COOKIE_SAMESITE=none (requires HTTPS).
# Local http dev: false / lax, because SameSite=None needs Secure.
COOKIE_SECURE=
COOKIE_SAMESITE=

# ── Contact notifications (optional) ─────────────────────────────────────────
# Submissions are always stored; email is skipped when unconfigured.
# Either Resend…
RESEND_API_KEY=
RESEND_FROM=
# …or SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Where notifications are delivered.
CONTACT_NOTIFY_EMAIL=

# Copy to .env and fill in. Compose reads .env automatically; .env is gitignored.
# Never commit real values.

# Database name inside the containerised mongo.
DB_NAME=hianzy

# Origin the browser loads the site from. This is what CORS must allow, and
# what the sitemap advertises. Change both if you publish on another port.
SITE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Where the browser should call the API. Baked into the bundle at build time,
# so a change here needs `docker compose build web`.
REACT_APP_BACKEND_URL=http://localhost:8010

# development keeps /docs open and the localhost CORS allowlist active.
# Set to production before exposing this anywhere.
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated addresses allowed to read contact submissions.
ADMIN_EMAILS=

# Optional contact-form notification. Left blank, submissions are stored only.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
